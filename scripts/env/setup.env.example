# Setup script for OPEN-DATASPACES-L3 APP
# Keycloak base URL
KEYCLOAK_BASE_URL=https://keycloak.example.com
# Create Keycloak realm
KEYCLOAK_REALM=example-realm
# Keycloak admin credentials
KEYCLOAK_MASTER_REALM=master
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_USERNAME=keycloak_admin_user_id
KEYCLOAK_PASSWORD=keycloak_admin_password
# Create Client ID for API authorization
KEYCLOAK_CLIENT_ID_API_ADMIN=system-api-authz-client
KEYCLOAK_CLAIM_OPEN_SYSTEM_ID_API_ADMIN=api-authz-client-open-system-id
# OpenFGA base URL
OPENFGA_BASE_URL=https://openfga.example.com
# PostgreSQL database connection details
POSTGRES_HOST=https://postgres.example.com
POSTGRES_PORT=5432
POSTGRES_DB=example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
# auth.tbl_api_keys table details
L3TBL_API_KEY=example-system-api-key
L3TBL_API_KEYS_ID=example-system-api-key-id
L3TBL_API_KEYS_NAME='example System API Key'
L3TBL_API_KEYS_USECASE=example-usecase
# auth.tbl_authz_stores table details
L3TBL_AUTHZ_STORES_ENVIRONMENT_NAME=example-environment
# auth.tbl_cidrs table details
L3TBL_CIDRS_CIDR='0.0.0.0/0'
