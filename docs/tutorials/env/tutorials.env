# Setup script for OPEN-DATASPACES-L3 APP Tutorials
# Keycloak base URL
KEYCLOAK_BASE_URL=http://id.ods.localhost
# Create Keycloak realm
KEYCLOAK_REALM=tutorials-realm
# Keycloak admin credentials
KEYCLOAK_MASTER_REALM=master
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_USERNAME=admin
KEYCLOAK_PASSWORD=Pass@123
# Create Client ID for API authorization
KEYCLOAK_CLIENT_ID_API_ADMIN=system-api-authz-client
KEYCLOAK_CLAIM_OPEN_SYSTEM_ID_API_ADMIN=api-authz-client-open-system-id
# OpenFGA base URL
OPENFGA_BASE_URL=http://authz.ods.localhost
# PostgreSQL database connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=db_ods
POSTGRES_USER=app_ods
POSTGRES_PASSWORD=password
# auth.tbl_api_keys table details
L3TBL_API_KEY=tutorials-system-api-key
L3TBL_API_KEYS_ID=tutorials-system-api-key-id
L3TBL_API_KEYS_NAME='tutorials System API Key'
L3TBL_API_KEYS_USECASE=tutorials-usecase
# auth.tbl_authz_stores table details
L3TBL_AUTHZ_STORES_ENVIRONMENT_NAME=local
# auth.tbl_cidrs table details
L3TBL_CIDRS_CIDR='0.0.0.0/0'